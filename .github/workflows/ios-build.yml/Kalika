name: Build IOSLauncher APK

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.4'

      - name: Find ZIP
        run: |
          ZIP=$(find . -maxdepth 2 -type f -iname "*.zip" | head -n 1)
          echo "ZIP=$ZIP"
          test -n "$ZIP"

      - name: Extract project
        run: |
          mkdir project
          unzip -q "$ZIP" -d project

      - name: Find Android project
        run: |
          PROJECT=$(find project -name settings.gradle.kts -type f -print -quit | xargs dirname)
          echo "PROJECT=$PROJECT"
          echo "PROJECT=$PROJECT" >> "$GITHUB_ENV"

      - name: Build APK
        run: |
          cd "$PROJECT"
          gradle assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: IOSLauncher-debug-apk
          path: '**/build/outputs/apk/debug/*.apk'
          if-no-files-found: error
